# Copy to .env and fill in. Used by start-dev.ps1 and local backend startup.

# MongoDB - use ONE of these:
# Option A: MongoDB Atlas (free, no Docker) - https://mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/maxro?retryWrites=true&w=majority
# Option B: Local Docker (run: docker-compose up -d mongodb)
# MONGODB_URI=mongodb://localhost:27017/maxro

# JWT signing secret - required for local auth flows
JWT_SECRET=replace-with-a-long-random-local-dev-secret

# Google Sign-In - Client ID only (no secret)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# USDA FoodData Central (optional)
# USDA_FOODDATA_API_KEY=

# FatSecret Platform API (optional)
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=

# Google AI (optional)
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-2.5-flash