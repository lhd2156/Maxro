# Copy to .env and fill in. Used by start-dev.ps1

# MongoDB - use ONE of these:
# Option A: MongoDB Atlas (free, no Docker) - https://mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/maxro?retryWrites=true&w=majority
# Option B: Local Docker (run: docker-compose up -d mongodb)
# MONGODB_URI=mongodb://localhost:27017/maxro

# Google Sign-In - Client ID only (no secret)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Nutritionix (optional)
# NUTRITIONIX_APP_ID=
# NUTRITIONIX_API_KEY=
